      "text": "External, unwanted energy introduced into the transmission line that corrupts the\nsignal.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "External, unwanted energy introduced into the transmission line that corrupts the signal.",
