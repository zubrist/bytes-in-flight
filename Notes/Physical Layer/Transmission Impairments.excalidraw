      "versionNonce": 1807320377,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790173100604,
      "link": null,
      "locked": false,
      "text": "2πf2 = 2π\n    f2 = 1 Hz",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2πf2 = 2π\n    f2 = 1 Hz",
      "autoResize": true,
