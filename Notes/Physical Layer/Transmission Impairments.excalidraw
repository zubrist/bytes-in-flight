      "isDeleted": false,
      "boundElements": null,
      "updated": 1790167586028,
      "link": null,
      "locked": false,
      "text": "The three main causes of impairment are \n**Attenuation**, **Distortion**, and **Noise**",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The three main causes of impairment are \n**Attenuation**, **Distortion**, and **Noise**",
