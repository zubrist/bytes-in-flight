    },
    {
      "id": "Y8b599WzRPHrncfpOiZs_",
      "type": "text",
      "x": 619.420096480316,
      "y": 2547.8096403787977,
      "width": 122.37995910644531,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
