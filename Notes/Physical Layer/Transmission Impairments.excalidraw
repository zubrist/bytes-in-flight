    },
    {
      "id": "qNlgVZ-1c9lsd_iwkk6LL",
      "type": "text",
      "x": 353.76962687262187,
      "y": 1766.42321722945,
      "width": 718.5089609012551,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0j",
      "roundness": null,
      "seed": 16068375,
      "version": 128,
      "versionNonce": 687367289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790171391858,
      "link": null,
      "locked": false,
      "text": "For an ideal channel with no noise, Henry Nyquist derived the theoretical\nmaximum bit rate",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For an ideal channel with no noise, Henry Nyquist derived the theoretical maximum bit rate",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Sc28dHtGvzLxpeaQOV15q",
      "type": "text",
      "x": 541.3843803738947,
      "y": 1830.8218683456798,
      "width": 279.2398681640625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0k",
      "roundness": null,
      "seed": 204404759,
      "version": 70,
      "versionNonce": 30242007,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790171471591,
      "link": null,
      "locked": false,
      "text": "Bit Rate =  2 * B * Log2 L ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit Rate =  2 * B * Log2 L ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aBXKg4aeHIiSVENBN3y82",
      "type": "text",
      "x": 363.17822084924853,
      "y": 1880.4350629087162,
      "width": 728.4207949288426,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0l",
      "roundness": null,
      "seed": 1626846681,
      "version": 205,
      "versionNonce": 707400985,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790171504997,
      "link": null,
      "locked": false,
      "text": "Practical Trade-off: While increasing L theoretically increases bit rate\nindefinitely, in practice it places a heavy burden on the receiver to\ndistinguish tiny voltage differences, reducing reliability",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Practical Trade-off: While increasing L theoretically increases bit rate indefinitely, in practice it places a heavy burden on the receiver to distinguish tiny voltage differences, reducing reliability",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "p88o_pkzfElC3imPlY17Z",
      "type": "text",
      "x": 351.8693415538261,
      "y": 1994.983128043806,
      "width": 435.1112365722656,
      "height": 34.66727810966128,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0m",
      "roundness": null,
      "seed": 1574846617,
      "version": 61,
      "versionNonce": 1608511961,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790171694236,
      "link": null,
      "locked": false,
      "text": "Noisy Channel: Shannon Capacity",
      "fontSize": 27.73382248772903,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Noisy Channel: Shannon Capacity",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5eIvp8UuU4Dr1FeMFwgkZ",
      "type": "text",
      "x": 477.36148881330536,
      "y": 2126.4944982059096,
      "width": 351.3398132324219,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 392233081,
      "version": 47,
      "versionNonce": 1854734839,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790171912943,
      "link": null,
      "locked": false,
      "text": "Capacity(C) =  B * log_2 (1 + SNR) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Capacity(C) =  B * log_2 (1 + SNR) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mkFNIqFM9ArGFtq5EQ2x6",
      "type": "text",
      "x": 378.8648053582551,
      "y": 2216.6007910627523,
      "width": 364.35986328125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1170154809,
      "version": 58,
      "versionNonce": 354670263,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790172246999,
      "link": null,
      "locked": false,
      "text": "Find Nyquist rate for the signal: \n            m(t) = 2sin (4πt)cos (2πt).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Find Nyquist rate for the signal: \n            m(t) = 2sin (4πt)cos (2πt).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PNxeWXBc-HBSq3e7uV-gU",
      "type": "text",
      "x": 410.6436406376406,
      "y": 2302.0503483418543,
      "width": 366.8797302246094,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 1413162393,
      "version": 50,
      "versionNonce": 790137721,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790172383667,
      "link": null,
      "locked": false,
      "text": "2 sinAcos B = sin(A + B) + sin(A - B)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2 sinAcos B = sin(A + B) + sin(A - B)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Wtp2JO6i04v0p1_pg3iKX",
      "type": "text",
      "x": 459.7399903678388,
      "y": 2359.871548833706,
      "width": 262.8798828125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b16",
      "roundness": null,
      "seed": 588437369,
      "version": 75,
      "versionNonce": 1529053591,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790172904672,
      "link": null,
      "locked": false,
      "text": "m(t) = 2sin (4πt)cos (2πt)\n      = sin(6πt) + sin(2πt)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "m(t) = 2sin (4πt)cos (2πt)\n      = sin(6πt) + sin(2πt)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w0DuJwSLziLWJc3rgJHuS",
      "type": "text",
      "x": 396.37526439345845,
      "y": 2451.898528904946,
      "width": 230.65989685058594,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 1243133463,
      "version": 66,
      "versionNonce": 2083034839,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790172920065,
      "link": null,
      "locked": false,
      "text": "we know that : ω = 2πf",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we know that : ω = 2πf",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9Mtg4vD8-3KpFOZbkwf71",
      "type": "text",
      "x": 462.41584155270175,
      "y": 2503.786217636565,
      "width": 74.15997314453125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 1303860825,
      "version": 10,
      "versionNonce": 796145081,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790172972161,
      "link": null,
      "locked": false,
      "text": "ω1 = 6π",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ω1 = 6π",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wO964uyhD7JXQG5y26WxL",
      "type": "text",
      "x": 621.2553695773327,
      "y": 2503.3892895203608,
      "width": 80.81999206542969,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1DV",
      "roundness": null,
      "seed": 909105657,
      "version": 63,
      "versionNonce": 1310644985,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790173021627,
      "link": null,
      "locked": false,
      "text": "ω2 = 2π",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ω2 = 2π",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rorT2Kfcho0Ja4vRwO29L",
      "type": "text",
      "x": 460.58056845568524,
      "y": 2558.056147777339,
      "width": 120.53994750976562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 708435801,
      "version": 47,
      "versionNonce": 728103993,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790173102027,
      "link": null,
      "locked": false,
      "text": "2πf1 = 6π\n    f1 = 3 Hz",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2πf1 = 6π\n    f1 = 3 Hz",
