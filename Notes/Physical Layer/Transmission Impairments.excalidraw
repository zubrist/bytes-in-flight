      "boundElements": null,
      "updated": 1790169768254,
      "link": null,
      "locked": false,
      "text": "An alteration in the form or shape of a **composite signal**",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An alteration in the form or shape of a **composite signal**",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TljPjub9RGD_VVzfW9n01",
      "type": "text",
      "x": 304.800048828125,
      "y": 978.2000427246094,
      "width": 947.8418627472297,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 2025481719,
      "version": 307,
      "versionNonce": 1347327799,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790169985686,
      "link": null,
      "locked": false,
      "text": "A composite signal consists of multiple frequency components. Each component has its own\npropagation speed through a medium, leading to varying delays in arrival time. These phase\nshifts alter the combined shape of the received wave",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A composite signal consists of multiple frequency components. Each component has its own propagation speed through a medium, leading to varying delays in arrival time. These phase shifts alter the combined shape of the received wave",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
