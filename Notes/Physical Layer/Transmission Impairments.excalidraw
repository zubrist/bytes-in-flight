      "isDeleted": false,
      "boundElements": null,
      "updated": 1790166983675,
      "link": null,
      "locked": false,
      "text": "When signals travel through imperfect physical media, the\nreceived signal differs from the transmitted signal.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When signals travel through imperfect physical media, the received signal differs from the transmitted signal.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
