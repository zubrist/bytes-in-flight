    },
    {
      "id": "cSz7lg05ppu0XLQy-Wkdo",
      "type": "text",
      "x": 384.0788494925059,
      "y": 2641.9497871808317,
      "width": 583.4706681524543,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Z",
      "roundness": null,
      "seed": 655944505,
      "version": 107,
      "versionNonce": 572187705,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790173267250,
      "link": null,
      "locked": false,
      "text": "the maximum frequency in the signal is f_max =3 Hz",
