      "isDeleted": false,
      "boundElements": null,
      "updated": 1790091279832,
      "link": null,
      "locked": false,
      "text": "The range of frequencies contained within a composite signal, or the\nrange of frequencies a physical medium can pass. It is calculated as the\ndifference between the highest and lowest frequencies",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The range of frequencies contained within a composite signal, or the range of frequencies a physical medium can pass. It is calculated as the difference between the highest and lowest frequencies",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "nhyew2o1FibCQzcjrTnyr",
