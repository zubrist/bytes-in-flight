    {
      "id": "-p5uDwVNGnWFy1fpv3z_K",
      "type": "text",
      "x": 249.39999389648438,
      "y": 322.4000244140625,
      "width": 885.0820007324219,
      "height": 53.97155495313783,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
