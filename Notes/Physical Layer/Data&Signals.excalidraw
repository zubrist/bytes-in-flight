      "isDeleted": false,
      "boundElements": null,
      "updated": 1790091361210,
      "link": null,
      "locked": false,
      "text": "Also referred to as digital bandwidth or maximum data rate, measuring\nthe speed of bit transmission across a link",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Also referred to as digital bandwidth or maximum data rate, measuring the speed of bit transmission across a link",
      "autoResize": false,
      "lineHeight": 1.25
    },
