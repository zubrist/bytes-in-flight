      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1544776061,
      "version": 139,
      "versionNonce": 1643642419,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790089243781,
      "link": null,
      "locked": false,
      "text": "Analog Data: Refers to continuous information that takes on continuous values\n(e.g., human voice producing continuous sound waves)",
      "fontSize": 21.588621981255134,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Analog Data: Refers to continuous information that takes on continuous values (e.g., human voice producing continuous sound waves)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gzZdwUXKmnhyKSmwZMwo2",
      "type": "text",
      "x": 240.93567759259946,
      "y": 414.9771533443202,
      "width": 780.239501953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1108837203,
      "version": 68,
      "versionNonce": 2033691091,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790089502074,
      "link": null,
      "locked": false,
      "text": "**Digital Data**: Refers to information that has discrete states and takes on\ndiscrete values (e.g., binary 0s and 1s stored in computer memory)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**Digital Data**: Refers to information that has discrete states and takes on discrete values (e.g., binary 0s and 1s stored in computer memory)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3JhfbudzhzNfYGbfBnirL",
      "type": "text",
      "x": 231.83385103413548,
      "y": 524.6925342510193,
      "width": 781.0194702148438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 318828435,
      "version": 71,
      "versionNonce": 1314442579,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790089529475,
      "link": null,
      "locked": false,
      "text": "**Analog Signals**: Have an infinite number of intensity levels over a period of\ntime. As the wave moves, it passes through infinitely many values along its path",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**Analog Signals**: Have an infinite number of intensity levels over a period of time. As the wave moves, it passes through infinitely many values along its path",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1RRTLWAQr3LgeabmNoO1u",
      "type": "text",
      "x": 238.8556494787943,
      "y": 658.1167672857257,
      "width": 784.3994750976562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1300350589,
      "version": 116,
      "versionNonce": 746727955,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790089741878,
      "link": null,
      "locked": false,
      "text": "Digital Signals: Can have only a limited, discrete number of defined voltage levels\n(e.g., +V for binary 1 and 0V for binary 0, or 4 distinct levels carrying 2 bits per\nlevel)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Digital Signals: Can have only a limited, discrete number of defined voltage levels (e.g., +V for binary 1 and 0V for binary 0, or 4 distinct levels carrying 2 bits per level)",
      "autoResize": false,
      "lineHeight": 1.25
    },
