      "isDeleted": false,
      "boundElements": null,
      "updated": 1790090476386,
      "link": null,
      "locked": false,
      "text": "Periodic and Non-Periodic (Aperiodic) Signals",
      "fontSize": 37.405868782124344,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Periodic and Non-Periodic (Aperiodic) Signals",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6wKfuc8wAYTNHiSM9TYok",
      "type": "text",
      "x": 257.2231348322457,
      "y": 1057.014277905135,
      "width": 774.4994506835938,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1998099,
      "version": 82,
      "versionNonce": 691770163,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790090039735,
      "link": null,
      "locked": false,
      "text": "Periodic Signals: Complete a pattern within a measurable time frame (called a\nperiod, T) and repeat that exact pattern over subsequent identical periods.\nThe completion of one full pattern is a cycle",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Periodic Signals: Complete a pattern within a measurable time frame (called a period, T) and repeat that exact pattern over subsequent identical periods. The completion of one full pattern is a cycle",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2Z0Cy_9V6G6iXhGBSr4Zy",
      "type": "text",
      "x": 306.18494275231967,
      "y": 1181.849709926339,
      "width": 771.0427848488331,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 255517107,
      "version": 74,
      "versionNonce": 462586803,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790090308224,
      "link": null,
      "locked": false,
      "text": "Frequency (f): The number of periods/cycles completed per second, measured in\nHertz ({Hz}). Frequency and period are mathematically inverse",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frequency (f): The number of periods/cycles completed per second, measured in Hertz ({Hz}). Frequency and period are mathematically inverse",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ydxoOX35YRSOCYgHlir3F",
      "type": "text",
      "x": 628.4410737252476,
      "y": 1254.3879287428667,
      "width": 73.8399658203125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1057335741,
      "version": 24,
      "versionNonce": 2006115741,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790090342967,
      "link": null,
      "locked": false,
      "text": "f = 1/T",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f = 1/T",
      "autoResize": true,
      "lineHeight": 1.25
    },
