      "isDeleted": false,
      "boundElements": null,
      "updated": 1790091428174,
      "link": null,
      "locked": false,
      "text": "An increase in analog bandwidth {Hz} yields a proportional increase\nin digital bandwidth {bps}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An increase in analog bandwidth {Hz} yields a proportional increase in digital bandwidth {bps}",
