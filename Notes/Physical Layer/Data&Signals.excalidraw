    },
    {
      "id": "jsAYqBItPbONZQKuUNTXO",
      "type": "text",
      "x": 555.9690621423455,
      "y": 1531.936206144294,
      "width": 600.8595581054688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 417282429,
      "version": 134,
      "versionNonce": 284574387,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790090590665,
      "link": null,
      "locked": false,
      "text": ": a periodic signal that can`t be  decomposed in simpler signal\n    e.g : sine wave",
      "fontSize": 20,
