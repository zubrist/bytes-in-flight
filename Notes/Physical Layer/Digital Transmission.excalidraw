    {
      "id": "BlnMi-A0PB4Q4WeK5732a",
      "type": "text",
      "x": 240.55190211775812,
      "y": 4672.34261617387,
      "width": 299.3689743625926,
      "height": 28.63352085340648,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
