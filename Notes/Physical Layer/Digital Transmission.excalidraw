      "y": 3477.211305057899,
      "width": 305.7276611328125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1519126562,
      "version": 73,
      "versionNonce": 1740414014,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498933724,
      "link": null,
      "locked": false,
      "text": "The signal stays at a positive voltage.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The signal stays at a positive voltage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
