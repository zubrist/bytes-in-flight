      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 28919806,
      "version": 204,
      "versionNonce": 338705314,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792500356801,
      "link": null,
      "locked": false,
      "text": "In Polar Differential Manchester encoding, data is represented using transitions instead\nof absolute voltage levels. Each bit period is divided into two equal halves, and a\ntransition always occurs in the middle of the bit period. The key distinction from\nManchester encoding is that whether there is a transition at the beginning of the bit\nperiod indicates the value of the bit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Polar Differential Manchester encoding, data is represented using transitions instead of absolute voltage levels. Each bit period is divided into two equal halves, and a transition always occurs in the middle of the bit period. The key distinction from Manchester encoding is that whether there is a transition at the beginning of the bit period indicates the value of the bit.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9zhvmSy466dQBv_JsHt8h",
      "type": "text",
      "x": 246.93793987092528,
      "y": 5466.468716843229,
      "width": 732.6461544594177,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 1902762174,
      "version": 223,
      "versionNonce": 591555682,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792500472242,
      "link": null,
      "locked": false,
      "text": "Bit 1 → No transition at the start of the bit period, but a mandatory transition in the\nmiddle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 1 → No transition at the start of the bit period, but a mandatory transition in the middle.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uFobqjsnY2isVeYfmaT0w",
      "type": "text",
      "x": 248.93547034797894,
      "y": 5525.447546913873,
      "width": 721.7442241277561,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 357276194,
      "version": 139,
      "versionNonce": 459956002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792500477950,
      "link": null,
      "locked": false,
      "text": "Bit 0 → A transition at the start of the bit period, plus the mandatory transition in the\nmiddle.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 0 → A transition at the start of the bit period, plus the mandatory transition in the middle.",
      "autoResize": false,
      "lineHeight": 1.25
    },
