      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498098071,
      "link": null,
      "locked": false,
      "text": "Bit 0 → Zero Voltage (Ground Level)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 0 → Zero Voltage (Ground Level)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MBaBiTEBtiFlGhljY-5qU",
      "type": "text",
      "x": 397.32466747623573,
      "y": 1657.0183182619987,
      "width": 284.927734375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1932756834,
      "version": 113,
      "versionNonce": 150551266,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498105239,
      "link": null,
      "locked": false,
      "text": "The signal remains at 0V (no signal).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The signal remains at 0V (no signal).",
      "autoResize": true,
      "lineHeight": 1.25
    },
