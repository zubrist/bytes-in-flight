      "text": "2) Polar Line Coding",
      "fontSize": 21.383171300578763,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Polar Line Coding",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X_NVGmLOMlZ7CKB72VJIe",
      "type": "text",
      "x": 290.8550939641012,
      "y": 2109.136648477282,
      "width": 721.5949342427075,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1360574142,
      "version": 93,
      "versionNonce": 1455902398,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498316299,
      "link": null,
      "locked": false,
      "text": "Polar line coding is a digital signaling scheme where two voltage levels\n(one positive and one negative) are used to represent binary data.\n Unlike unipolar schemes, it does not use zero voltage—both ‘1’ and ‘0’\nare represented by non-zero voltages of opposite polarity.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Polar line coding is a digital signaling scheme where two voltage levels (one positive and one negative) are used to represent binary data.\n Unlike unipolar schemes, it does not use zero voltage—both ‘1’ and ‘0’ are represented by non-zero voltages of opposite polarity.",
      "autoResize": false,
      "lineHeight": 1.25
    },
