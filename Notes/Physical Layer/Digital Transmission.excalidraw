      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499151014,
      "link": null,
      "locked": false,
      "text": "Polar NRZ-I",
      "fontSize": 32.30009158681715,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Polar NRZ-I",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iZeZBW9_mIDCNCJv4wxdP",
      "type": "text",
      "x": 263.79306133744353,
      "y": 3938.005053337693,
      "width": 654.7323796076342,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 466268798,
      "version": 127,
      "versionNonce": 799328830,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499161813,
      "link": null,
      "locked": false,
      "text": "In NRZ-I (Non-Return-to-Zero Inverted), the signal is inverted only when a 1 is\nencountered. A 0 does not cause any change in the signal level.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In NRZ-I (Non-Return-to-Zero Inverted), the signal is inverted only when a 1 is encountered. A 0 does not cause any change in the signal level.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "SRSwWp41hIP6eyF8yJkjX",
      "type": "text",
      "x": 827.1996269616609,
      "y": 3716.4242609389185,
      "width": 27.32794189453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 1141103458,
      "version": 6,
      "versionNonce": 646217250,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499216967,
      "link": null,
      "locked": false,
      "text": "1111",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1111",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1XETEmHwCkAhL2iNAwujF",
      "type": "text",
      "x": 268.25509979051475,
      "y": 4023.4472626046213,
      "width": 403.72430419921875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 1774770530,
      "version": 65,
      "versionNonce": 1834097890,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499302790,
      "link": null,
      "locked": false,
      "text": "Bit 1 → Causes a transition (inversion) in the signal",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 1 → Causes a transition (inversion) in the signal",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XD-26TKqOx_mJ6KMmfTfF",
      "type": "text",
      "x": 351.82891270338166,
      "y": 4053.057205966837,
      "width": 434.111572265625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04",
      "roundness": null,
      "seed": 383083966,
      "version": 112,
      "versionNonce": 249831358,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499311477,
      "link": null,
      "locked": false,
      "text": "If the previous signal was high, it changes to low (-ve).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the previous signal was high, it changes to low (-ve).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C6Uxcb42NuwFDphiuC3pY",
      "type": "text",
      "x": 353.47965040371884,
      "y": 4086.81128149455,
      "width": 436.3355712890625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 2011913506,
      "version": 104,
      "versionNonce": 595122210,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499318316,
      "link": null,
      "locked": false,
      "text": "If the previous signal was low, it changes to high (+ve).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the previous signal was low, it changes to high (+ve).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zY_7FF09kHsxmTmU4p2VD",
      "type": "text",
      "x": 274.21121420507455,
      "y": 4138.5231225532125,
      "width": 286.82843017578125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b06",
      "roundness": null,
      "seed": 1423834622,
      "version": 119,
      "versionNonce": 1577497086,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499332435,
      "link": null,
      "locked": false,
      "text": "Bit 0 → No change in the signal level",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 0 → No change in the signal level",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ELgIoIvMip21u8VuBwSS2",
      "type": "text",
      "x": 336.4519591998221,
      "y": 4173.658540339538,
      "width": 377.839599609375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b07",
      "roundness": null,
      "seed": 1854367970,
      "version": 111,
      "versionNonce": 1362770978,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499335155,
      "link": null,
      "locked": false,
      "text": "The signal remains the same as the previous bit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The signal remains the same as the previous bit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hoymYnRx-7-2cU_t0ebEB",
      "type": "text",
      "x": 252.71954221279447,
      "y": 4220.321264286323,
      "width": 674.1165752552176,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1688061886,
      "version": 115,
      "versionNonce": 227264994,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499363615,
      "link": null,
      "locked": false,
      "text": "important: In NRZ-I,  the initial state can be either Low or High, but it must be\npredefined or agreed upon by the sender and receiver.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "important: In NRZ-I,  the initial state can be either Low or High, but it must be predefined or agreed upon by the sender and receiver.",
      "autoResize": false,
      "lineHeight": 1.25
    },
