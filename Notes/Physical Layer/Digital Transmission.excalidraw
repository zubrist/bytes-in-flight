      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499529212,
      "link": null,
      "locked": false,
      "text": "Polar Manchester Encoding",
      "fontSize": 22.906816682725182,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Polar Manchester Encoding",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tXDZVjK6pkSCys3RuDfh7",
      "type": "text",
      "x": 241.39509529876744,
      "y": 4709.856733439065,
      "width": 722.3207224262516,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1537281954,
      "version": 99,
      "versionNonce": 1393532030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499665433,
      "link": null,
      "locked": false,
      "text": "In Polar Manchester encoding, each bit period is split into two equal halves. A key feature\nof this encoding scheme is that a transition occurs in the middle of the bit period, ensuring\nsynchronization.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Polar Manchester encoding, each bit period is split into two equal halves. A key feature of this encoding scheme is that a transition occurs in the middle of the bit period, ensuring synchronization.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "UViMPn7IVjepOgdxd07bt",
      "type": "text",
      "x": 234.87384697252162,
      "y": 4803.414341649052,
      "width": 695.9943850651424,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1576430974,
      "version": 174,
      "versionNonce": 1252096674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792500119030,
      "link": null,
      "locked": false,
      "text": "Bit 0 → High-to-Low Transition (Starts at +V and ends at -V within the bit period).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 0 → High-to-Low Transition (Starts at +V and ends at -V within the bit period).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "6bM8H3yPC-eJSEAwp-8uw",
      "type": "text",
      "x": 235.7405353959981,
      "y": 4859.240509606929,
      "width": 706.0025228060608,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 1963962722,
      "version": 235,
      "versionNonce": 1658538366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792500130291,
      "link": null,
      "locked": false,
      "text": "Bit 1 → Low-to-High Transition (Starts at -V and ends at +V within the bit period).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 1 → Low-to-High Transition (Starts at -V and ends at +V within the bit period).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "flOMpJu1ZYyWsWoldG1qb",
      "type": "text",
      "x": 259.915189702098,
      "y": 4897.108938381272,
      "width": 672.1577294679353,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 1778912702,
      "version": 316,
      "versionNonce": 13802302,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792499760791,
      "link": null,
      "locked": false,
      "text": "A transition always occurs in the middle of the bit period, ensuring synchronization.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A transition always occurs in the middle of the bit period, ensuring synchronization.",
      "autoResize": false,
      "lineHeight": 1.25
    },
