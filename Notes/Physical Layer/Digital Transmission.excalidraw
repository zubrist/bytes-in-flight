      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498930854,
      "link": null,
      "locked": false,
      "text": "Bit 0 → High Voltage (Positive Level, e.g., +V)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 0 → High Voltage (Positive Level, e.g., +V)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AOdyYMA389-ab5V6ZrkFH",
      "type": "text",
