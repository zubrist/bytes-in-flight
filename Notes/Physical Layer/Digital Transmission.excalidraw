      "text": "Polar NRZ-L",
      "fontSize": 39.48317672126503,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Polar NRZ-L",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2WzEsbPiJfs-3_rRD1x46",
      "type": "text",
      "x": 263.8644517528623,
      "y": 3271.4833444114724,
      "width": 683.2527404645833,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 1334380130,
      "version": 112,
      "versionNonce": 2104158818,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498845738,
      "link": null,
      "locked": false,
      "text": "In Polar NRZ-L (Non-Return-to-Zero Level) encoding, two voltage levels, positive and\nnegative, are utilized instead of only one. The signal maintains a constant voltage for\nthe entire duration of the bit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In Polar NRZ-L (Non-Return-to-Zero Level) encoding, two voltage levels, positive and negative, are utilized instead of only one. The signal maintains a constant voltage for the entire duration of the bit.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "trSxKP0uut6iSScACB7bh",
      "type": "text",
      "x": 268.49981898171416,
      "y": 3369.688185500794,
      "width": 352.1243591308594,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 1418693246,
      "version": 25,
      "versionNonce": 1824649662,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498924458,
      "link": null,
      "locked": false,
      "text": "Bit 1 → Low Voltage (Negative Level, e.g., -V)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit 1 → Low Voltage (Negative Level, e.g., -V)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bXhwuqqBQU8scM0dVMMbd",
      "type": "text",
      "x": 358.2609692338104,
      "y": 3402.4062543345476,
      "width": 310.04766845703125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 635626594,
      "version": 56,
      "versionNonce": 976464574,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498928475,
      "link": null,
      "locked": false,
      "text": "The signal stays at a negative voltage.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The signal stays at a negative voltage.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
