      "versionNonce": 733819838,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792498102920,
      "link": null,
      "locked": false,
      "text": "The signal remains at a high level (e.g., +V).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The signal remains at a high level (e.g., +V).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sW4-8W-d4BeWOzk2yxvki",
      "type": "text",
      "x": 315.70955088625726,
      "y": 1619.1491434933341,
      "width": 290.4764709472656,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
