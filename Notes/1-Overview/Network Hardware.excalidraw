    {
      "id": "aCUfyni7z4PYBepqaSxll",
      "type": "text",
      "x": 362.40225823520575,
      "y": 3581.970645842931,
      "width": 766.266512062477,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 2012286056,
      "version": 205,
      "versionNonce": 312573032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788875808818,
      "link": null,
      "locked": false,
      "text": "The TCP/IP Protocol Suite is the practical, implemented architecture of the\nmodern Internet.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The TCP/IP Protocol Suite is the practical, implemented architecture of the modern Internet.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "tK24VXugWa0xEJ7pRldWL",
      "type": "text",
      "x": 353.26549639178666,
      "y": 3687.519443550578,
      "width": 851.7827389371388,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
