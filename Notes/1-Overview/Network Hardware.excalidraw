      "updated": 1788875491084,
      "link": null,
      "locked": false,
      "text": "TCP/IP Model",
      "fontSize": 33.149782042406095,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TCP/IP Model",
