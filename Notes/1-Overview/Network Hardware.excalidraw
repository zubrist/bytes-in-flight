      "isDeleted": false,
      "boundElements": null,
      "updated": 1788873331160,
      "link": null,
      "locked": false,
      "text": "The security level in MAN is high and strict as compared to WAN.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The security level in MAN is high and strict as compared to WAN.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jS1Ba7S91PpcX10Y4d6cX",
      "type": "text",
      "x": 389.79022216796875,
      "y": 2083.7999877929688,
      "width": 703.0195312499999,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 59338344,
      "version": 158,
      "versionNonce": 826610280,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788873335448,
      "link": null,
      "locked": false,
      "text": "It support to transmit data in both directions concurrently because of\ndual bus architecture.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It support to transmit data in both directions concurrently because of dual bus architecture.",
