      "isDeleted": false,
      "boundElements": null,
      "updated": 1788873326448,
      "link": null,
      "locked": false,
      "text": "MAN offers high-speed connectivity in which the speed ranges from 10-100\nMbps.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MAN offers high-speed connectivity in which the speed ranges from 10-100 Mbps.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "q51aiZXGq8sUBUISahrpX",
      "type": "text",
