      "index": "aZ",
      "roundness": null,
      "seed": 1891583512,
      "version": 164,
      "versionNonce": 12710936,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788876025115,
      "link": null,
      "locked": false,
      "text": "Technical Mapping and Addressing In the TCP/IP model, the Application layer is\nconsolidated, absorbing the functions of the OSI Session and Presentation layers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Technical Mapping and Addressing In the TCP/IP model, the Application layer is consolidated, absorbing the functions of the OSI Session and Presentation layers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mU3SY3XyeyZtvbXCCcW5I",
      "type": "text",
