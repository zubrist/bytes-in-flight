    {
      "id": "8ErbObya-Vb2J5ejQgOLB",
      "type": "text",
      "x": 342.310302734375,
      "y": 1104.5000597000121,
      "width": 619.5794677734375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0M",
      "roundness": null,
      "seed": 1158008099,
      "version": 160,
      "versionNonce": 278221165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622178376,
      "link": null,
      "locked": false,
      "text": "1. Message: The information payload (text, numbers, images, or bitstream)\nbeing transmitted. \n\n2. Sender: The originating device (laptop/workstation) that initiates and\ntransmits the message. \n\n 3. Receiver: The destination device (desktop computer) that receives the\nincoming transmission.  \n\n4. Transmission Medium: The physical conduit (glowing fiber-optic line) bridging\nsender and receiver. \n\n 5. Protocol: The set of rules (governing syntax, semantics, and timing) that\ncoordinates communication between devices.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Message: The information payload (text, numbers, images, or bitstream) being transmitted. \n\n2. Sender: The originating device (laptop/workstation) that initiates and transmits the message. \n\n 3. Receiver: The destination device (desktop computer) that receives the incoming transmission.  \n\n4. Transmission Medium: The physical conduit (glowing fiber-optic line) bridging sender and receiver. \n\n 5. Protocol: The set of rules (governing syntax, semantics, and timing) that coordinates communication between devices.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-tFs3El5lq46nIcz9ZxHP",
