    {
      "id": "PpxVG5h5ZXYJ7giOnNDrZ",
      "type": "text",
      "x": 360.7523193359375,
      "y": 1512.7999864578246,
      "width": 578.4954833984375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 82837539,
      "version": 144,
      "versionNonce": 21101571,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622266470,
      "link": null,
      "locked": false,
      "text": "Information is represented within these systems primarily as bit patterns:",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Information is represented within these systems primarily as bit patterns:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sgXyTNMqpRXuJ49RXSzCd",
      "type": "text",
      "x": 366.40032958984375,
      "y": 1550.4000841140746,
      "width": 638.3994140625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 36292493,
      "version": 148,
      "versionNonce": 1709768653,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622288761,
      "link": null,
      "locked": false,
      "text": "Text: Represented via the International Reference Alphabet (IRA). This includes\nASCII (traditionally a 7-bit code representing 127 characters, often used with an\n8th bit for parity) and Unicode (a 32-bit pattern for all written languages).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Text: Represented via the International Reference Alphabet (IRA). This includes ASCII (traditionally a 7-bit code representing 127 characters, often used with an 8th bit for parity) and Unicode (a 32-bit pattern for all written languages).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "aRcupJZXYLFHPinqTCKZA",
      "type": "text",
      "x": 365.38427734375,
      "y": 1629.6000352859496,
      "width": 412.431640625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 1675756483,
      "version": 173,
      "versionNonce": 401866723,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622310485,
      "link": null,
      "locked": false,
      "text": "Numbers: Directly converted into binary bit patterns.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Numbers: Directly converted into binary bit patterns.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
