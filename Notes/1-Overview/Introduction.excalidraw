    {
      "id": "WXV1bse61tUaxclSgor1x",
      "type": "text",
      "x": 336.9501953125,
      "y": 375.29998779296875,
      "width": 636.099609375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1653152451,
      "version": 89,
      "versionNonce": 810538701,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621061377,
      "link": null,
      "locked": false,
      "text": "At its core, Data Communication is defined as the exchange of data between\ntwo devices via some form of physical transmission medium.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "At its core, Data Communication is defined as the exchange of data between two devices via some form of physical transmission medium.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mUpoId31CCEg5k6b3gT_l",
      "type": "text",
      "x": 336.36834716796875,
      "y": 431.1999816894531,
      "width": 611.663330078125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 1011583053,
      "version": 67,
      "versionNonce": 1877280621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621158084,
      "link": null,
      "locked": false,
      "text": "The fundamental effectiveness of any data communication system is measured\nagainst four critical performance metrics:",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The fundamental effectiveness of any data communication system is measured against four critical performance metrics:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vmr0xJv6PQzhH5MVadvQ2",
      "type": "text",
      "x": 384.44818115234375,
      "y": 492.8001403808594,
      "width": 601.103515625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1456715971,
      "version": 110,
      "versionNonce": 1035566755,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621308490,
      "link": null,
      "locked": false,
      "text": "Delivery: The system must deliver data to the correct, intended destination.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Delivery: The system must deliver data to the correct, intended destination.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xEmSEbTJ91FHsEDGjqijF",
      "type": "text",
      "x": 382.71209716796875,
      "y": 523.4001159667969,
      "width": 520.175537109375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 2079549677,
      "version": 104,
      "versionNonce": 565581443,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621306505,
      "link": null,
      "locked": false,
      "text": "Accuracy: Data must be delivered without alteration or corruption.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Accuracy: Data must be delivered without alteration or corruption.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aGIpjdgYMAi0z8BAcYJRy",
      "type": "text",
      "x": 381.0962829589844,
      "y": 550.8001098632812,
      "width": 628.6073608398438,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 2114300003,
      "version": 168,
      "versionNonce": 242048451,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621304199,
      "link": null,
      "locked": false,
      "text": "Timeliness: This refers to the usability window; data must be delivered in a time\nframe that remains useful for the application.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Timeliness: This refers to the usability window; data must be delivered in a time frame that remains useful for the application.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "6rFL751fa7Cv2KIUf8gJz",
      "type": "text",
      "x": 379.32830810546875,
      "y": 596.8001098632812,
      "width": 644.9434814453125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 215073613,
      "version": 115,
      "versionNonce": 1087292355,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788621302330,
      "link": null,
      "locked": false,
      "text": "Jitter: This is the variation in packet arrival time, measuring the uniformity of the\ndelay.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jitter: This is the variation in packet arrival time, measuring the uniformity of the delay.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
