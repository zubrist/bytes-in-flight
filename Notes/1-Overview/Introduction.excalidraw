      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622416822,
      "link": null,
      "locked": false,
      "text": "Audio & Video: Continuous signals that are digitised into discrete bit patterns for\ntransmission.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
