      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Bus Topology: A multipoint connection where all devices share a single backbone cable.",
      "fontSize": 20.478972344585305,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bus Topology: A multipoint connection where all devices share a single backbone cable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
