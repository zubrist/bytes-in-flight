      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Cost-effective but difficult to isolate faults. \nA backbone break disconnects the entire segment.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cost-effective but difficult to isolate faults. \nA backbone break disconnects the entire segment.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
