      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Formula: For n nodes, the network requires n(n-1)/2 duplex links and (n-1) ports per device.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Formula: For n nodes, the network requires n(n-1)/2 duplex links and (n-1) ports per device.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uWw3BgWh1wCJO2l_rxKFH",
      "type": "text",
      "x": 315.90503566864174,
      "y": 3218.1159559296198,
      "width": 692.783447265625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 663498691,
      "version": 135,
      "versionNonce": 1253306861,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Offers the highest fault tolerance and privacy but suffers from prohibitive cabling costs\nand complexity as n increases.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Offers the highest fault tolerance and privacy but suffers from prohibitive cabling costs and complexity as n increases.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
