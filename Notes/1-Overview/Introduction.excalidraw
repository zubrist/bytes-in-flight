      "updated": 1788622760131,
      "link": null,
      "locked": false,
      "text": "Network Hardware and Physical Topologies",
      "fontSize": 36.24498780249852,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Network Hardware and Physical Topologies",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "69vp6Ml0Cj237FEqmq1Y-",
      "type": "text",
      "x": 319.15500603098866,
      "y": 2630.1419366041423,
      "width": 716.7354736328125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 2034886829,
      "version": 84,
      "versionNonce": 561776003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622850079,
      "link": null,
      "locked": false,
      "text": "Hardware connections are generally categorised as Point-to-Point (a dedicated link between\ntwo devices) or Multipoint (a shared link where multiple devices share capacity).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hardware connections are generally categorised as Point-to-Point (a dedicated link between two devices) or Multipoint (a shared link where multiple devices share capacity).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "t2VJqzb27QLmqFrOPim-X",
      "type": "text",
      "x": 274.18426542183033,
      "y": 2683.4728231468816,
      "width": 218.6213977156193,
      "height": 52.47254949824309,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 1648769869,
      "version": 110,
      "versionNonce": 2113015917,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
