      "y": 2763.646571636715,
      "width": 826.4943431374076,
      "height": 24.255027144540858,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1149494819,
      "version": 132,
      "versionNonce": 932149965,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Mesh Topology: Every device has a dedicated point-to-point link to every other device.",
      "fontSize": 19.404021715632695,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mesh Topology: Every device has a dedicated point-to-point link to every other device.",
      "autoResize": true,
      "lineHeight": 1.25
    },
