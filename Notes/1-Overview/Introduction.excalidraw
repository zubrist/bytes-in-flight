      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "Ring Topology: Each device is connected only to its two immediate neighbours",
      "fontSize": 20.911016965797174,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ring Topology: Each device is connected only to its two immediate neighbours",
      "autoResize": true,
      "lineHeight": 1.25
    },
