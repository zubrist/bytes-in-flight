      "isDeleted": false,
      "boundElements": null,
      "updated": 1788624002792,
      "link": null,
      "locked": false,
      "text": "While easy to reconfigure, the central node remains a single point of failure.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "While easy to reconfigure, the central node remains a single point of failure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
