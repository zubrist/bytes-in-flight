      "isDeleted": false,
      "boundElements": null,
      "updated": 1788622348331,
      "link": null,
      "locked": false,
      "text": "Images: Converted into a matrix of Pixels, where each pixel is a sequence of bits.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Images: Converted into a matrix of Pixels, where each pixel is a sequence of bits.",
      "autoResize": true,
      "lineHeight": 1.25
    },
