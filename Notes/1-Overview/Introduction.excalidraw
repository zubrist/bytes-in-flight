      "type": "text",
      "x": 307.76123485677266,
      "y": 3185.643303915835,
      "width": 782.3022057171158,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
